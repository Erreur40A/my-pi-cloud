POSTGRES_USER=user_cloud
POSTGRES_DB=cloud
# The PostgreSQL container reads its passwords from ./secrets/: db_password.txt (superuser), db_owner_password.txt (schema owner, Flyway)
# and db_app_password.txt (application role). Create them, put one password in each, then `chown 999` and `chmod 400` them.
# Development only: `bootRun` runs as your user and cannot read these files, so repeat the owner and application passwords here.
# Leave them out on the Pi. Spring Boot never needs the superuser password.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
