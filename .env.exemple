POSTGRES_USER=user_cloud
# The PostgreSQL container reads its password from ./secrets/db_password.txt: create it, put your password in it, then `chown 999` and `chmod 400` it.
# Development only: `bootRun` runs as your user and cannot read that file, so repeat the same password here. Leave it out on the Pi.
POSTGRES_PASSWORD=
POSTGRES_DB=cloud
# Passwords of the schema owner (Flyway) and the application role, created by postgres/init/create-roles.sh.
# Same files and permissions as above: ./secrets/db_owner_password.txt and ./secrets/db_app_password.txt.
# Development only, like POSTGRES_PASSWORD: repeat them here. Leave them out on the Pi.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
