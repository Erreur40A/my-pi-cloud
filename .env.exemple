POSTGRES_USER=user_cloud
# The PostgreSQL container reads its password from ./secrets/db_password.txt: create it, put your password in it, then `chown 999` and `chmod 400` it.
# Development only: `bootRun` runs as your user and cannot read that file, so repeat the same password here. Leave it out on the Pi.
POSTGRES_PASSWORD=
POSTGRES_DB=cloud
